# Bu dosya yalnızca bir şablondur — değerleri kendi .env dosyanıza girin.
# Gerçek değerler asla buraya yazılmamalı ve commit edilmemelidir.

DATABASE_URL=
REDIS_URL=
JWT_SECRET=
JWT_EXPIRES_IN=
PORT=
CORS_ORIGIN=

# LinkedIn OAuth (https://www.linkedin.com/developers/apps üzerinden bir uygulama oluşturup
# "Sign In with LinkedIn using OpenID Connect" ürününü ekleyin)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# Firebase Admin SDK — Google ve LinkedIn kimlik jetonlarını doğrular, LinkedIn için
# custom token üretir. Firebase Console > Project Settings > Service accounts >
# "Generate new private key" ile indirilen JSON'daki değerler.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Private key tek satırda, satır sonları \n olarak, tümü çift tırnak içinde:
FIREBASE_PRIVATE_KEY=

# Dosya depolama sürücüsü: "local" (varsayılan, backend/uploads klasörü) veya
# "firebase" (Firebase Storage). Render gibi geçici disklerde yüklenen dosyalar
# her redeploy'da silindiği için PRODUCTION'da "firebase" kullanın.
STORAGE_DRIVER=
# Firebase Storage kova adı (STORAGE_DRIVER=firebase iken gerekir). Firebase Console
# > Storage'daki kova adı; genelde <project>.appspot.com veya <project>.firebasestorage.app.
# Belirtilmezse <FIREBASE_PROJECT_ID>.appspot.com varsayılır.
FIREBASE_STORAGE_BUCKET=

# Google Places API (Find Place + Place Details) — https://console.cloud.google.com/apis/credentials
# üzerinden bir API key oluşturup "Places API"yi etkinleştirin. Mekan detaylarını
# (telefon, web sitesi, çalışma saatleri, kategori, doğru isim) zenginleştirmek için
# kullanılır; tanımlı değilse mekan detayları mevcut veritabanı verisiyle çalışmaya
# devam eder (özellik sessizce devre dışı kalır).
GOOGLE_PLACES_API_KEY=

# E-posta doğrulama (SMTP). Kayıt sırasında kullanıcıya doğrulama linki göndermek için
# kullanılır. Gmail için: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<gmail
# adresiniz>, SMTP_PASS=<Google Hesabı > Güvenlik > Uygulama şifreleri'nden üretilen
# 16 haneli şifre>. Tanımlı değilse doğrulama e-postası gönderilmez (dev'de link log'a
# düşer). APP_URL, doğrulama linkindeki frontend adresidir (prod'da Vercel adresi);
# tanımsızsa CORS_ORIGIN'in ilk değeri kullanılır.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
APP_URL=
