generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PlaceType {
  HOTEL
  CAFE
  LIBRARY
  COWORKING
}

enum Region {
  MURATPASA
  KONYAALTI
  KEPEZ
  LARA
  KALEICI
  DOSEMEALTI
  AKSU
  BELEK
}

enum PlaceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LevelRating {
  LOW
  MEDIUM
  HIGH
}

enum CommentReportStatus {
  PENDING
  DISMISSED
}

enum NotificationType {
  SUGGESTION_APPROVED
  SUGGESTION_REJECTED
  FAVORITE_PLACE_UPDATED
  COMMENT_REPORTED
  COMMENT_DELETED
  FAVORITE_LOW_OCCUPANCY
  CHAT_REPLY
}

enum SocialNotificationType {
  POST_LIKE
  POST_COMMENT
  NEW_FOLLOWER
}

// RemoteRehber Pro (premium) abonelik durumları.
// FREE: abonelik yok (varsayılan). TRIAL: 15 günlük ücretsiz deneme aktif.
// ACTIVE: ücretli abonelik aktif. PAST_DUE: ödeme başarısız, ödeme bekleniyor.
// CANCELED: iptal edildi ama dönem sonuna kadar premium sürüyor. EXPIRED: süresi
// dolmuş / premium erişim kapalı.
enum SubscriptionStatus {
  FREE
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  name         String   @map("full_name")
  companyName  String?  @map("company_name")
  role         Role     @default(USER)
  provider     String   @default("local")
  providerId   String?  @map("provider_id")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  places              Place[]
  reviews             Review[]
  favorites           Favorite[]
  occupancyCheckIns   OccupancyCheckIn[]
  messages            PlaceMessage[]
  comments            Comment[]
  commentHelpfulVotes CommentHelpfulVote[]
  commentReports      CommentReport[]
  notifications       Notification[]

  // Social Feed modülü
  socialProfile            SocialProfile?
  socialPosts              SocialPost[]
  postLikes                PostLike[]
  postComments             PostComment[]
  following                Follow[]             @relation("Follower")
  followers                Follow[]             @relation("Following")
  socialNotifications      SocialNotification[] @relation("Recipient")
  socialNotificationsActed SocialNotification[] @relation("Actor")

  // Premium / Billing modülü (RemoteRehber Pro)
  subscription        Subscription?
  subscriptionHistory SubscriptionHistory[]
  paymentMethods      PaymentMethod[]
  payments            Payment[]
  invoices            Invoice[]
  trialUsage          TrialUsage?

  @@unique([provider, providerId])
  @@map("users")
}

model Place {
  id              Int         @id @default(autoincrement())
  name            String
  type            PlaceType
  region          Region      @map("district")
  address         String
  lat             Float       @map("latitude")
  lng             Float       @map("longitude")
  description     String?
  priceLevel      Int         @default(2) @map("price_level")
  photoUrls       String[]    @default([]) @map("photo_urls")
  outletLevel     LevelRating @default(MEDIUM) @map("socket_level")
  noiseLevel      LevelRating @default(MEDIUM) @map("quietness_level")
  deskFriendly    Boolean     @default(true) @map("is_desk_friendly")
  openingHours    String?     @map("working_hours")
  openTime        String?     @map("open_time")
  closeTime       String?     @map("close_time")
  hasWifi         Boolean     @default(true) @map("has_wifi")
  hasAC           Boolean     @default(true) @map("has_air_conditioning")
  meetingSuitable Boolean     @default(false) @map("is_meeting_friendly")
  laptopFriendly  Boolean     @default(true) @map("is_laptop_friendly")
  status          PlaceStatus @default(APPROVED)
  createdById     Int?        @map("created_by_id")
  createdBy       User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  reviews           Review[]
  favorites         Favorite[]
  occupancyCheckIns OccupancyCheckIn[]
  messages          PlaceMessage[]
  comments          Comment[]
  notifications     Notification[]

  @@map("places")
}

model Review {
  id              Int      @id @default(autoincrement())
  placeId         Int      @map("place_id")
  place           Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  userId          Int      @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  internetSpeed   Int      @map("internet_rating")
  outletCount     Int      @map("socket_rating")
  noiseLevel      Int      @map("quietness_rating")
  coffeeQuality   Int      @map("coffee_rating")
  workEnvironment Int      @map("work_environment")
  priceLevel      Int      @map("price_level")
  overallRating   Int      @map("rating")
  comment         String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([placeId, userId])
  @@map("reviews")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId   Int      @map("place_id")
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, placeId])
  @@map("favorites")
}

model OccupancyCheckIn {
  id        Int         @id @default(autoincrement())
  placeId   Int         @map("place_id")
  place     Place       @relation(fields: [placeId], references: [id], onDelete: Cascade)
  userId    Int         @map("user_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     LevelRating @map("occupancy_level")
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([placeId, createdAt])
  @@map("occupancy_checkins")
}

model Comment {
  id        Int       @id @default(autoincrement())
  placeId   Int       @map("place_id")
  place     Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  photoUrl  String?   @map("photo_url")
  isPinned  Boolean   @default(false) @map("is_pinned")
  pinnedAt  DateTime? @map("pinned_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  helpfulVotes CommentHelpfulVote[]
  reports      CommentReport[]

  @@index([placeId, createdAt])
  @@map("comments")
}

model CommentHelpfulVote {
  id        Int      @id @default(autoincrement())
  commentId Int      @map("comment_id")
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([commentId, userId])
  @@map("comment_helpful_votes")
}

model CommentReport {
  id        Int                 @id @default(autoincrement())
  commentId Int                 @map("comment_id")
  comment   Comment             @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    Int                 @map("user_id")
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String?
  status    CommentReportStatus @default(PENDING)
  createdAt DateTime            @default(now()) @map("created_at")

  @@unique([commentId, userId])
  @@map("comment_reports")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  placeId   Int?             @map("place_id")
  // Bildirimler her zaman bir mekan bağlamına aittir (sohbet cevabı, favori
  // güncellemesi, öneri sonucu, ...). Mekan silinince o mekana ait bildirim de
  // anlamsız kalır ve linki ölür; bu yüzden SetNull yerine Cascade ile birlikte
  // silinir — böylece "sahipsiz" (placeId'si boşalmış) bildirim oluşmaz.
  place     Place?           @relation(fields: [placeId], references: [id], onDelete: Cascade)
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, type, placeId, createdAt])
  @@map("notifications")
}

model PlaceMessage {
  id        Int      @id @default(autoincrement())
  placeId   Int      @map("place_id")
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([placeId, createdAt])
  @@map("place_messages")
}

// ===========================================================================
// Social Feed modülü — Instagram benzeri sosyal medya bölümü.
// Mevcut Notification modeli tamamen mekan (Place) bağlamlıdır; sosyal
// bildirimler post/kullanıcı bağlamlı olduğundan ayrı bir SocialNotification
// tablosu kullanılır ve çalışan bildirim sistemi bozulmaz.
// ===========================================================================

model SocialProfile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String?
  // Admin bir kullanıcıyı sosyal bölümde engellediğinde işaretlenir; engelli
  // kullanıcı paylaşım/yorum/beğeni/takip yapamaz (mevcut auth sistemi korunur).
  isBlocked Boolean  @default(false) @map("is_blocked")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("social_profiles")
}

model SocialPost {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  caption   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  images        PostImage[]
  likes         PostLike[]
  comments      PostComment[]
  notifications SocialNotification[]

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("social_posts")
}

model PostImage {
  id       Int        @id @default(autoincrement())
  postId   Int        @map("post_id")
  post     SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  url      String
  // Galeri sıralaması: fotoğrafların yüklenme/gösterim sırası.
  position Int        @default(0)

  @@index([postId, position])
  @@map("post_images")
}

model PostLike {
  id        Int        @id @default(autoincrement())
  postId    Int        @map("post_id")
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int        @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @map("created_at")

  @@unique([postId, userId])
  @@index([postId])
  @@map("post_likes")
}

model PostComment {
  id        Int        @id @default(autoincrement())
  postId    Int        @map("post_id")
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int        @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([postId, createdAt])
  @@map("post_comments")
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int      @map("follower_id")
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId Int      @map("following_id")
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model SocialNotification {
  id        Int                    @id @default(autoincrement())
  // Bildirimi alan kullanıcı.
  userId    Int                    @map("user_id")
  user      User                   @relation("Recipient", fields: [userId], references: [id], onDelete: Cascade)
  // Eylemi yapan kullanıcı (beğenen/yorum yapan/takip eden).
  actorId   Int                    @map("actor_id")
  actor     User                   @relation("Actor", fields: [actorId], references: [id], onDelete: Cascade)
  type      SocialNotificationType
  postId    Int?                   @map("post_id")
  post      SocialPost?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  isRead    Boolean                @default(false) @map("is_read")
  createdAt DateTime               @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("social_notifications")
}

// ===========================================================================
// Premium / Billing modülü — "RemoteRehber Pro" aboneliği.
// Kart bilgileri (PAN, CVV) HİÇBİR ZAMAN saklanmaz; yalnızca ödeme sağlayıcısının
// döndürdüğü token/referans (provider*Id) ve gösterim için güvenli meta veriler
// (brand, last4, expMonth/Year) tutulur. Para tutarları kuruş cinsinden Int
// olarak saklanır (float yuvarlama hatalarından kaçınmak için); 2500 = 25,00 TL.
// ===========================================================================

model Subscription {
  id                     Int                @id @default(autoincrement())
  userId                 Int                @unique @map("user_id")
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                 SubscriptionStatus @default(FREE)
  // Ücretli plan adı (ör. "RemoteRehber Pro"); FREE durumda null.
  planName               String?            @map("plan_name")
  // Aylık ücret (kuruş). Varsayılan 2500 = 25,00 TL.
  priceAmount            Int                @default(2500) @map("price_amount")
  currency               String             @default("TRY")
  startedAt              DateTime?          @map("started_at")
  trialEndsAt            DateTime?          @map("trial_ends_at")
  currentPeriodStart     DateTime?          @map("current_period_start")
  currentPeriodEnd       DateTime?          @map("current_period_end")
  // İptal talep edildiğinde işaretlenir; dönem sonuna kadar premium sürer.
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt             DateTime?          @map("canceled_at")
  // Ödeme sağlayıcısındaki referanslar (Stripe/iyzico/... müşteri ve abonelik id'si).
  provider               String?
  providerCustomerId     String?            @map("provider_customer_id")
  providerSubscriptionId String?            @map("provider_subscription_id")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  history        SubscriptionHistory[]
  paymentMethods PaymentMethod[]
  payments       Payment[]
  invoices       Invoice[]

  @@map("subscriptions")
}

// Abonelik durum geçişlerinin denetim kaydı (audit log).
model SubscriptionHistory {
  id             Int                 @id @default(autoincrement())
  userId         Int                 @map("user_id")
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId Int?                @map("subscription_id")
  subscription   Subscription?       @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  fromStatus     SubscriptionStatus? @map("from_status")
  toStatus       SubscriptionStatus  @map("to_status")
  reason         String?
  createdAt      DateTime            @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("subscription_history")
}

// Ödeme yöntemi referansı. Tam kart numarası TUTULMAZ — yalnızca sağlayıcı token'ı
// ve gösterim için güvenli alanlar (brand/last4/expiry).
model PaymentMethod {
  id                      Int           @id @default(autoincrement())
  userId                  Int           @map("user_id")
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId          Int?          @map("subscription_id")
  subscription            Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  provider                String
  providerPaymentMethodId String        @map("provider_payment_method_id")
  brand                   String?
  last4                   String?
  expMonth                Int?          @map("exp_month")
  expYear                 Int?          @map("exp_year")
  isDefault               Boolean       @default(false) @map("is_default")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@map("payment_methods")
}

model Payment {
  id                Int           @id @default(autoincrement())
  userId            Int           @map("user_id")
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId    Int?          @map("subscription_id")
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoiceId         Int?          @map("invoice_id")
  invoice           Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  // Tutar kuruş cinsinden. status: "pending" | "succeeded" | "failed" | "refunded".
  amount            Int
  currency          String        @default("TRY")
  status            String        @default("pending")
  provider          String?
  providerPaymentId String?       @map("provider_payment_id")
  paidAt            DateTime?     @map("paid_at")
  createdAt         DateTime      @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("payments")
}

model Invoice {
  id                Int           @id @default(autoincrement())
  userId            Int           @map("user_id")
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId    Int?          @map("subscription_id")
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  // Tutar kuruş cinsinden. status: "open" | "paid" | "void".
  amount            Int
  currency          String        @default("TRY")
  status            String        @default("open")
  periodStart       DateTime?     @map("period_start")
  periodEnd         DateTime?     @map("period_end")
  issuedAt          DateTime      @default(now()) @map("issued_at")
  paidAt            DateTime?     @map("paid_at")
  provider          String?
  providerInvoiceId String?       @map("provider_invoice_id")

  payments Payment[]

  @@index([userId, issuedAt])
  @@map("invoices")
}

// 15 günlük ücretsiz denemenin yalnızca bir kez kullanılabilmesini garanti eder
// (userId @unique). Bir kullanıcı ikinci kez deneme başlatamaz.
model TrialUsage {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt DateTime @default(now()) @map("started_at")
  endsAt    DateTime @map("ends_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("trial_usages")
}
