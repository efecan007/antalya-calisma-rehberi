# Bu dosya yalnızca bir şablondur — değerleri kendi .env dosyanıza girin.
# Gerçek değerler asla buraya yazılmamalı ve commit edilmemelidir.

VITE_API_URL=

# Firebase Web config (yalnızca yerel `npm run dev` için; Docker build'inde bu
# değerler docker-compose build args üzerinden gelir). Gizli değildir.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
